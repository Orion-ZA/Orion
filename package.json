{
  "name": "orion",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@mapbox/mapbox-sdk": "^0.16.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "lucide-react": "^0.539.0",
    "mapbox-gl": "^3.14.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-firebase-hooks": "^5.1.1",
    "react-icons": "^5.5.0",
    "react-map-gl": "^8.0.4",
    "react-router-dom": "^7.9.1",
    "react-scripts": "^5.0.1",
    "recharts": "^3.2.1",
    "styled-components": "^6.1.11",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "set CI=false && react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "semantic-check": "node semantic-html-checker.js",
    "semantic-check:verbose": "node semantic-html-checker.js --verbose --fix-suggestions",
    "semantic-check:components": "node semantic-html-checker.js --path src/components --verbose --fix-suggestions",
    "semantic-check:pages": "node semantic-html-checker.js --path src/pages --verbose --fix-suggestions",
    "lint": "node linter.js",
    "lint:verbose": "node linter.js --verbose --fix-suggestions",
    "lint:accessibility": "node linter.js --accessibility --verbose --fix-suggestions",
    "lint:performance": "node linter.js --performance --verbose --fix-suggestions",
    "lint:security": "node linter.js --security --verbose --fix-suggestions",
    "lint:file": "node linter.js --file",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "format:staged": "prettier --write --ignore-unknown",
    "prepare": "husky"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "no-unused-vars": "warn"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
